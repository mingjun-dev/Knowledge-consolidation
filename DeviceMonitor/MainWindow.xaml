<Window x:Class="DeviceMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DeviceMonitor"
        xmlns:deviceMonitor="clr-namespace:DeviceMonitor"
        xmlns:views="clr-namespace:DeviceMonitor.Views"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources>
        <deviceMonitor:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <deviceMonitor:BoolToTextConverter x:Key="BoolToTextConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Margin="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
            </Grid>
            <Border Background="Gray" BorderBrush="White" BorderThickness="1" Height="40" Width="Auto" >
                <TextBlock VerticalAlignment="Center">
                 <Run Text="设备监控面板" Foreground="White"/>
                </TextBlock>
            </Border>
            <Grid Grid.Column="1">
                <Button Content="刷新"  HorizontalAlignment="Right"/>
            </Grid>
        </Grid>

        <Grid Grid.Row="1" Grid.Column="0" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock  Text="设备列表" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            </StackPanel>
            <ListBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Background="Black" Foreground="White">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M2,2 L14,2 L14,10 L2,10 Z M4,4 L12,4 L12,8 L4,8 Z M6,11 L10,11 L8,14 Z"  Stroke="Black" Fill="LightGray" Width="16" Height="16" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" Margin="5"/>
                            <TextBlock Text="{Binding IpAddress}"/>
                            <Ellipse Width="10" Height="10" Fill="{Binding IsConnected,Converter={StaticResource BoolToBrushConverter}}" Margin="5,0,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="0" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock   Text="设备详情" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            </StackPanel>
            <Grid Grid.Row="1" Grid.Column="1" Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0">
                    <Run Text="{Binding SelectedDevice.Name}"/>
                    <Run Text="{Binding SelectedDevice.IpAddress}"/>
                </TextBlock>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="状态:"/>
                    <Ellipse Width="10" Height="10" Fill="{Binding IsConnected,Converter={StaticResource BoolToBrushConverter}}" Margin="5,0,0,0"/>
                    <TextBlock Text="{Binding  IsConnected,Converter={StaticResource BoolToTextConverter}}"/>
                    <Button Content="连接" Command="{Binding ConnectCommand}" Margin="10,0,0,0"/>
                    <Button Content="断开" Command="{Binding DisconnectCommand}" Margin="10,0,0,0"/>
                </StackPanel>
                <Grid Grid.Row="2">
                  <views:LogView/>
                </Grid>
                <TextBox Text="多行文本区" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap">

                </TextBox>

            </Grid>
        </Grid>
        <views:StatusBarView Grid.Row="2"/>
    </Grid>
</Window>
